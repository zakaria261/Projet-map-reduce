# ─────────────────────────────────────────────────────────────
# .env.example — Template de configuration pour le mode multi-machine
#
# Copier ce fichier en .env et remplir les vraies IPs LAN :
#   cp .env.example .env
#
# Pour trouver l'IP LAN d'un pote (Windows) :
#   ipconfig  →  chercher "Adresse IPv4" sous Wi-Fi
# ─────────────────────────────────────────────────────────────

# Adresses des workers MAP sur les PCs de tes potes
# Format : "IP_POTE1:PORT,IP_POTE2:PORT,IP_POTE3:PORT"
# Les ports correspondent aux MAP workers (6000, 6001, 6002...)
MAP_HOSTS=192.168.1.42:6000,192.168.1.43:6001,192.168.1.44:6002

# Nombre de reducers (doit correspondre à docker-compose.multi.yml)
NUM_REDUCERS=2

# Top N mots à afficher dans les résultats
TOP_N=20
